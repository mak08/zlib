(defpackage :zlib-tests (:use :cl) (:export :run-tests))
(in-package :zlib-tests)
(defun octets (&rest values) (make-array (length values) :element-type '(unsigned-byte 8) :initial-contents values))
(defun fails (function &optional (type 'error))
  (handler-case (progn (funcall function) nil) (error (condition) (typep condition type))))
(defun compress-raw (bytes &optional (flush :sync))
  (zlib:with-codec (codec (zlib:make-deflater :max-output (+ 1024 (* 2 (length bytes)))))
    (zlib:deflate-bytes codec bytes :flush flush)))
(defun fill-noise (bytes)
  (loop with seed = 12345 for i below (length bytes) do
    (setf seed (ldb (byte 32 0) (+ (* 1664525 seed) 1013904223))
          (aref bytes i) (ldb (byte 8 24) seed)))
  bytes)
(defun test-roundtrips ()
  (dolist (size '(0 1 16383 16384 16385 70000))
    (let ((bytes (make-array size :element-type '(unsigned-byte 8))))
      (fill-noise bytes)
      (dolist (format '(:raw :zlib :gzip))
        (zlib:with-codec (encoder (zlib:make-deflater :format format :max-output 200000))
          (let ((compressed (zlib:deflate-bytes encoder bytes :flush :finish)))
            (assert (eq :finished (zlib:codec-state encoder)))
            (zlib:with-codec (decoder (zlib:make-inflater :format format :max-output size))
              (assert (equalp bytes (zlib:inflate-bytes decoder compressed :finish t)))
              (assert (= size (zlib:codec-output-count decoder))))))))))
(defun test-sync ()
  ;; RFC 7692's raw DEFLATE encoding of "Hello", with restored flush trailer.
  (let ((wire (octets #xf2 #x48 #xcd #xc9 #xc9 #x07 #x00 #x00 #x00 #xff #xff))
        (hello (octets 72 101 108 108 111)))
    (zlib:with-codec (decoder (zlib:make-inflater :max-output 5))
      (assert (equalp hello (zlib:inflate-bytes decoder wire)))
      (assert (eq :open (zlib:codec-state decoder)))
      (assert (fails (lambda () (zlib:inflate-bytes decoder wire)) 'zlib:zlib-output-limit))
      (assert (eq :failed (zlib:codec-state decoder)))
      (zlib:reset-codec decoder)
      (assert (equalp hello (zlib:inflate-bytes decoder wire))))
    (zlib:with-codec (encoder (zlib:make-deflater))
      (let ((first (zlib:deflate-bytes encoder hello)))
        (assert (equalp #(0 0 255 255) (subseq first (- (length first) 4))))
        (zlib:reset-codec encoder)
        (assert (equalp first (zlib:deflate-bytes encoder hello))))))
  ;; Contexts may retain history across sync flushes; input/output are chunked.
  (zlib:with-codec (encoder (zlib:make-deflater))
    (zlib:with-codec (decoder (zlib:make-inflater))
      (let ((bytes (make-array 50000 :element-type '(unsigned-byte 8) :initial-element 65)))
        (dotimes (message 2)
          (let ((compressed (zlib:deflate-bytes encoder bytes)) (parts nil))
            (loop for i from 0 below (length compressed) by 3 do
              (push (zlib:inflate-bytes decoder compressed :start i :end (min (+ i 3) (length compressed))) parts))
            (assert (equalp bytes (apply #'concatenate '(vector (unsigned-byte 8)) (nreverse parts)))))))))
  (let* ((data (octets 1 2 3 4 5)) (expected (compress-raw data)))
    (zlib:with-codec (encoder (zlib:make-deflater :max-output (length expected)))
      (assert (equalp expected (zlib:deflate-bytes encoder data))))
    (zlib:with-codec (encoder (zlib:make-deflater :max-output (1- (length expected))))
      (assert (fails (lambda () (zlib:deflate-bytes encoder data)) 'zlib:zlib-output-limit))))
  ;; :NONE feeds a stream without a message boundary; :FINISH drains it.
  (zlib:with-codec (encoder (zlib:make-deflater))
    (let ((first (zlib:deflate-bytes encoder (octets 1 2) :flush :none))
          (last (zlib:deflate-bytes encoder (octets 3 4) :flush :finish)))
      (zlib:with-codec (decoder (zlib:make-inflater))
        (assert (equalp #(1 2 3 4) (zlib:inflate-bytes decoder
                                  (concatenate '(vector (unsigned-byte 8)) first last) :finish t)))))))
(defun test-errors ()
  (assert (fails (lambda () (zlib:make-deflater :window-bits 8))))
  (assert (fails (lambda () (zlib:make-inflater :format :unknown))))
  (let ((bytes (make-array 50000 :element-type '(unsigned-byte 8) :initial-element 0)))
    (zlib:with-codec (decoder (zlib:make-inflater :max-output 10))
      (assert (fails (lambda () (zlib:inflate-bytes decoder (compress-raw bytes))) 'zlib:zlib-output-limit))))
  (zlib:with-codec (decoder (zlib:make-inflater))
    (assert (fails (lambda () (zlib:inflate-bytes decoder (octets 7))) 'zlib:zlib-error))
    (zlib:reset-codec decoder)
    (let ((data (compress-raw (octets 1 2 3) :finish)))
      (assert (fails (lambda () (zlib:inflate-bytes decoder data :end (1- (length data)) :finish t))))
      (zlib:reset-codec decoder)
      (assert (fails (lambda () (zlib:inflate-bytes decoder (concatenate '(vector (unsigned-byte 8)) data #(0))))))))
  (let ((codec (zlib:make-deflater)))
    (zlib:close-codec codec) (zlib:close-codec codec)
    (assert (fails (lambda () (zlib:deflate-bytes codec (octets)))))
    (assert (fails (lambda () (zlib:reset-codec codec))))))

(defun test-protocol-boundaries ()
  (let* ((hello (octets 72 101 108 108 111))
         (final (compress-raw hello :finish))
         (wire (concatenate '(vector (unsigned-byte 8)) final #(0))))
    (zlib:with-codec (decoder (zlib:make-inflater :max-output 5))
      (multiple-value-bind (output status consumed)
          (zlib:inflate-bytes decoder wire :allow-trailing t)
        (assert (equalp hello output)) (assert (eq status :finished))
        (assert (= consumed (length final)))
        (zlib:restart-inflater decoder)
        (assert (= 5 (zlib:codec-output-count decoder)))
        (assert (not (zlib:inflater-sync-point-p decoder)))
        (zlib:inflate-bytes decoder wire :start consumed)
        (assert (zlib:inflater-sync-point-p decoder))
        (zlib:inflate-bytes decoder (octets 0 0 255 255))
        (assert (not (zlib:inflater-sync-point-p decoder)))
        (assert (fails (lambda () (zlib:inflate-bytes decoder final)) 'zlib:zlib-output-limit)))))
  (zlib:with-codec (decoder (zlib:make-inflater))
    (assert (fails (lambda () (zlib:restart-inflater decoder))))
    (zlib:close-codec decoder)
    (assert (fails (lambda () (zlib:inflater-sync-point-p decoder)))))
  (zlib:with-codec (encoder (zlib:make-deflater))
    (assert (fails (lambda () (zlib:inflater-sync-point-p encoder))))))

(defun test-python ()
  (let* ((directory (merge-pathnames (format nil "zlib-tests-~a/" (gensym)) (uiop:temporary-directory)))
         (source (merge-pathnames "source" directory)) (encoded (merge-pathnames "encoded" directory))
         (peer (merge-pathnames "peer" directory))
         (payload (make-array 40000 :element-type '(unsigned-byte 8))))
    (fill-noise payload)
    (ensure-directories-exist source)
    (unwind-protect
         (progn
           (with-open-file (out source :direction :output :element-type '(unsigned-byte 8)) (write-sequence payload out))
           (with-open-file (out encoded :direction :output :element-type '(unsigned-byte 8))
             (write-sequence (compress-raw payload) out))
           (uiop:run-program
            (list "python3" "-c"
                  "import pathlib,sys,zlib; a,b,c=map(pathlib.Path,sys.argv[1:]); data=a.read_bytes(); d=zlib.decompressobj(-15); assert d.decompress(b.read_bytes())==data; assert not d.eof; e=zlib.compressobj(wbits=-15); c.write_bytes(e.compress(data)+e.flush(zlib.Z_SYNC_FLUSH))"
                  (namestring source) (namestring encoded) (namestring peer)))
           (zlib:with-codec (decoder (zlib:make-inflater :max-output (length payload)))
             (assert (equalp payload (zlib:inflate-bytes decoder (with-open-file (in peer :element-type '(unsigned-byte 8))
                     (let ((data (make-array (file-length in) :element-type '(unsigned-byte 8))))
                       (read-sequence data in) data)))))))
      (uiop:delete-directory-tree directory :validate t :if-does-not-exist :ignore))))
(defun run-tests ()
  (test-roundtrips) (test-sync) (test-errors) (test-protocol-boundaries) (test-python)
  (let ((bytes (octets 0 1 127 128 255)))
    (assert (equalp bytes (zlib:gunzip (zlib:gzip-bytes bytes)))))
  (format t "~&zlib streaming, limits, reset, legacy gzip and Python interoperability tests passed.~%"))
